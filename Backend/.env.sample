## ToriType Backend (.env.sample)
# Copy this file to `.env` and fill in the values.

# --- MongoDB ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGO_DB_NAME=toritype
MONGO_COLLECTION_NAME=audio_transcripts

# --- Auth / JWT ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Remote ML Services (Hugging Face Space URL) ---
# Example: https://<your-space-username>-<space-name>.hf.space
ML_SERVICE_URL=https://<your-hf-space-subdomain>.hf.space

# Optional separate sentiment service. If empty, backend will use ML_SERVICE_URL
SENTIMENT_SERVICE_URL=

# --- Optional OpenAI Mock Toggle ---
# Set to true only if you want to mock OpenAI usage in dev flows
USE_OPENAI_MOCK=false
OPENAI_API_KEY=
